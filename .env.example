# ─────────────────────────────────────────────────────────────
# BrainBites Admin — Firebase Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your real Firebase
# project values. All values are available in the Firebase
# Console → Project Settings → Your Apps → Web.
# ─────────────────────────────────────────────────────────────

# Firebase API Key (from Project Settings → Web API Key)
VITE_FIREBASE_API_KEY=

# Firebase Auth Domain (e.g. your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=

# Firebase Project ID (e.g. your-project-id)
VITE_FIREBASE_PROJECT_ID=

# Firebase Storage Bucket (e.g. your-project-id.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=

# Firebase Messaging Sender ID (numeric string)
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Web App ID (format: 1:<MESSAGING_SENDER_ID>:web:<hash>)
# Found in Project Settings → Your Apps → Web → "App ID"
VITE_FIREBASE_APP_ID=
